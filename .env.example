# Supabase backend connection.
# Copy this file to `.env` and fill in values from Supabase Dashboard > Settings > API.
#   URL              Dashboard > Settings > API > Project URL
#   Publishable key  Dashboard > Settings > API > API Keys > Publishable key
#                    (new "sb_publishable_xxx" format; legacy `anon` key is being
#                    deprecated — use the publishable key going forward.)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
